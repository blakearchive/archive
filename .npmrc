# package-lock.json was generated without auto-installed peer dependencies.
# jest-preset-angular@14 (test only) declares a peer on @angular-devkit/build-angular,
# which this project does not use (the build is plain webpack); npm 7+ would otherwise
# pull in build-angular 18 and fail against Angular 17 with ERESOLVE on `npm ci`.
legacy-peer-deps=true
